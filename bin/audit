#!/usr/bin/env ruby
require "optparse"
require_relative "../config/environment"

options = { verbose: false, trace: nil }
parser = OptionParser.new do |opts|
  opts.banner = "usage: bin/audit [--verbose] [--trace] [--trace-path=PATH] PRODUCT_HANDLE"
  opts.on("--verbose", "print full tool inputs and results") { options[:verbose] = true }
  opts.on("--trace", "write a redacted raw request/response trace to traces/") { options[:trace] = true }
  opts.on("--trace-path=PATH", "write the trace to PATH instead of the default traces/ location") do |path|
    options[:trace] = path
  end
end
parser.parse!(ARGV)

handle = ARGV[0]
if handle.nil?
  warn parser.banner
  exit 1
end

trace_path =
  case options[:trace]
  when nil, false then nil
  when true then Rails.root.join("traces", "#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}-#{handle}.jsonl").to_s
  else options[:trace]
  end

reporters = [ GeoAudit::Reporter::Terminal.new(verbose: options[:verbose]) ]
reporters << GeoAudit::Reporter::Trace.new(path: trace_path) if trace_path
reporter = (reporters.size == 1) ? reporters.first : GeoAudit::Reporter::Multi.new(*reporters)

begin
  result = GeoAudit::Auditor.new(reporter:).call(handle:)
rescue => e
  warn "audit failed: #{e.message}"
  exit 1
end
